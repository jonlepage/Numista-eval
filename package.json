{
  "name": "numista-eval",
  "version": "0.3.1",
  "description": "Evaluate the fairness of a coin swap on Numista — prices, rarity, grades and verdict",
  "type": "module",
  "bin": {
    "numista-eval": "./dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.fr.md",
    "evaluate.example.bat"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "evaluate": "tsx src/index.ts doc/echange_etangua_jonlepage_1v2.xls",
    "test": "vitest",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "numista",
    "numismatic",
    "coin",
    "exchange",
    "swap",
    "evaluation",
    "rarity",
    "grading",
    "excel"
  ],
  "author": "JonLepage",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonlepage/Numista.git"
  },
  "homepage": "https://github.com/jonlepage/Numista#readme",
  "bugs": {
    "url": "https://github.com/jonlepage/Numista/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cfb": "^1.2.2",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "xlsx-chart": "^0.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.4"
  }
}